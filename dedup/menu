#!/bin/bash

# CSV Deduplication Menu
# Entry point for selecting the appropriate deduplication script

set -e  # Exit on any error

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "🔍 CSV DEDUPLICATION TOOLS"
echo "════════════════════════════════════════════════════════════════"
echo "Choose the right deduplication method for your needs:"
echo "════════════════════════════════════════════════════════════════"
echo

echo "Available deduplication methods:"
echo
echo "1) EXACT DUPLICATES (dedup_exact)"
echo "   • Removes rows that are completely identical across ALL columns"
echo "   • Fastest method for simple exact duplicates"
echo "   • Example: Two rows with exactly the same data in every field"
echo
echo "2) SINGLE-COLUMN DUPLICATES (dedup_single)"
echo "   • Removes rows with duplicate values in ONE selected column"
echo "   • Choose automatic (first/last/best) or manual selection"
echo "   • Example: Remove duplicate email addresses, keeping one person per email"
echo
echo "3) MULTI-COLUMN DUPLICATES (dedup_multi)"
echo "   • Removes rows with duplicate combinations across MULTIPLE columns"
echo "   • Choose automatic (first/last/best) or manual selection"
echo "   • Example: Remove duplicates based on firstName + lastName combination"
echo
echo "4) HELP - Show detailed explanations"
echo
echo "5) EXIT"
echo

# Function to show detailed help
show_help() {
    echo "═══════════════════════════════════════════════════════════════════════════════════"
    echo "DETAILED HELP"
    echo "═══════════════════════════════════════════════════════════════════════════════════"
    echo
    echo "🔍 EXACT DUPLICATES (dedup_exact)"
    echo "   Use when: You have rows that are byte-for-byte identical"
    echo "   How it works: Compares entire rows, removes completely identical ones"
    echo "   Speed: Fastest"
    echo "   Example scenarios:"
    echo "     • Data exported multiple times with duplicate entries"
    echo "     • Copy-paste errors creating identical rows"
    echo "     • Import errors that duplicated records"
    echo
    echo "🔍 SINGLE-COLUMN DUPLICATES (dedup_single)"
    echo "   Use when: You want to keep only one record per unique value in one column"
    echo "   How it works: Groups by one column, lets you choose which duplicate to keep"
    echo "   Speed: Fast"
    echo "   Automatic strategies:"
    echo "     • First: Keep the first occurrence"
    echo "     • Last: Keep the last occurrence (most recent)" 
    echo "     • Best: Keep the row with most filled columns"
    echo "   Manual mode: Review each duplicate group and choose which to keep"
    echo "   Example scenarios:"
    echo "     • Customer list with duplicate email addresses"
    echo "     • Product catalog with duplicate SKUs"
    echo "     • User database with duplicate IDs"
    echo
    echo "🔍 MULTI-COLUMN DUPLICATES (dedup_multi)"
    echo "   Use when: You want to remove duplicates based on a combination of columns"
    echo "   How it works: Creates composite keys from multiple columns"
    echo "   Speed: Moderate (depends on number of columns)"
    echo "   Same automatic strategies and manual mode as single-column"
    echo "   Example scenarios:"
    echo "     • People database: firstName + lastName + birthDate"
    echo "     • Address list: street + city + zipCode"
    echo "     • Product inventory: brand + model + size"
    echo "     • Event registrations: eventID + participantEmail"
    echo
    echo "💡 TIPS FOR CHOOSING:"
    echo "   • Start with exact duplicates if you suspect identical rows"
    echo "   • Use single-column for simple ID/email/SKU deduplication"
    echo "   • Use multi-column when no single field is unique enough"
    echo "   • Manual mode gives you full control but takes longer"
    echo "   • 'Best' strategy prioritizes keeping the most complete records"
    echo
    echo "═══════════════════════════════════════════════════════════════════════════════════"
    echo
}

# Main menu loop
while true; do
    read -p "Enter your choice (1-5): " -r choice
    
    case $choice in
        1)
            echo
            echo "🚀 Launching EXACT duplicate removal..."
            echo "   Running: $SCRIPT_DIR/dedup_exact"
            echo
            "$SCRIPT_DIR/dedup_exact"
            break
            ;;
        2)
            echo
            echo "🚀 Launching SINGLE-COLUMN duplicate removal..."
            echo "   Running: $SCRIPT_DIR/dedup_single"
            echo
            "$SCRIPT_DIR/dedup_single"
            break
            ;;
        3)
            echo
            echo "🚀 Launching MULTI-COLUMN duplicate removal..."
            echo "   Running: $SCRIPT_DIR/dedup_multi"
            echo
            "$SCRIPT_DIR/dedup_multi"
            break
            ;;
        4)
            echo
            show_help
            echo "Press Enter to return to main menu..."
            read -r
            echo
            echo "🔍 CSV DEDUPLICATION TOOLS"
            echo "════════════════════════════════════════════════════════════════"
            echo "Choose the right deduplication method for your needs:"
            echo "════════════════════════════════════════════════════════════════"
            echo
            echo "Available deduplication methods:"
            echo
            echo "1) EXACT DUPLICATES (dedup_exact)"
            echo "   • Removes rows that are completely identical across ALL columns"
            echo "   • Fastest method for simple exact duplicates"
            echo "   • Example: Two rows with exactly the same data in every field"
            echo
            echo "2) SINGLE-COLUMN DUPLICATES (dedup_single)"
            echo "   • Removes rows with duplicate values in ONE selected column"
            echo "   • Choose automatic (first/last/best) or manual selection"
            echo "   • Example: Remove duplicate email addresses, keeping one person per email"
            echo
            echo "3) MULTI-COLUMN DUPLICATES (dedup_multi)"
            echo "   • Removes rows with duplicate combinations across MULTIPLE columns"
            echo "   • Choose automatic (first/last/best) or manual selection"
            echo "   • Example: Remove duplicates based on firstName + lastName combination"
            echo
            echo "4) HELP - Show detailed explanations"
            echo
            echo "5) EXIT"
            echo
            ;;
        5)
            echo
            echo "👋 Goodbye!"
            exit 0
            ;;
        *)
            echo "❌ Invalid choice. Please enter 1, 2, 3, 4, or 5."
            ;;
    esac
done