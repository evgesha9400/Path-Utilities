#!/bin/bash

# CSV Difference Script
# Compares two CSV files and outputs differrent or similar rows

set -e  # Exit on any error

# Function to get CSV header
get_header() {
    head -n 1 "$1"
}

# Function to find longest common substring
longest_common_substring() {
    python3 -c "
import sys
s1, s2 = '$1', '$2'

# Remove file extensions for comparison
s1 = s1.replace('.csv', '')
s2 = s2.replace('.csv', '')

max_len = 0
result = ''

for i in range(len(s1)):
    for j in range(i + 1, len(s1) + 1):
        substr = s1[i:j]
        if substr in s2 and len(substr) > max_len:
            max_len = len(substr)
            result = substr

# Clean up the result - remove trailing numbers, underscores, hyphens
import re
result = re.sub(r'[_\-\s]*[0-9]+[_\-\s]*$', '', result)
result = result.strip('_- ')

if result and len(result) >= 3:  # Only use if meaningful length
    print(result)
else:
    # Fallback to first part of first filename
    first_part = s1.split('_')[0].split('-')[0].split(' ')[0]
    print(first_part if first_part else 'comparison')
"
}

# Function to compare CSV files and find differences
compare_csv_files() {
    local file1="$1"
    local file2="$2"
    local diff_type="$3"  # "column" or "row"
    local output_type="$4"  # "difference" or "without_difference"
    local base_name="$5"
    
    python3 -c "
import csv
import sys
from collections import OrderedDict

def read_csv_as_dict_list(filename):
    with open(filename, 'r', encoding='utf-8') as f:
        reader = csv.DictReader(f)
        return [dict(row) for row in reader], reader.fieldnames

def write_csv_from_dict_list(filename, data, fieldnames):
    with open(filename, 'w', encoding='utf-8', newline='') as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(data)

# Read both files
file1_data, file1_headers = read_csv_as_dict_list('$file1')
file2_data, file2_headers = read_csv_as_dict_list('$file2')

diff_type = '$diff_type'
output_type = '$output_type'
base_name = '$base_name'

if diff_type == 'column':
    # Column-based comparison
    if output_type == 'difference':
        # Find columns that exist in one file but not the other
        headers1_set = set(file1_headers)
        headers2_set = set(file2_headers)
        
        unique_to_file1 = headers1_set - headers2_set
        unique_to_file2 = headers2_set - headers1_set
        
        if unique_to_file1 or unique_to_file2:
            # Create output with different columns
            all_unique_headers = list(unique_to_file1) + list(unique_to_file2)
            
            # Combine data from both files for unique columns
            output_data = []
            
            # Add data from file1 for its unique columns
            for i, row in enumerate(file1_data):
                new_row = {'source_file': '$file1', 'row_number': i+1}
                for col in unique_to_file1:
                    new_row[col] = row.get(col, '')
                if unique_to_file1:
                    output_data.append(new_row)
            
            # Add data from file2 for its unique columns  
            for i, row in enumerate(file2_data):
                new_row = {'source_file': '$file2', 'row_number': i+1}
                for col in unique_to_file2:
                    new_row[col] = row.get(col, '')
                if unique_to_file2:
                    output_data.append(new_row)
            
            output_headers = ['source_file', 'row_number'] + all_unique_headers
            output_file = base_name + '_column_difference.csv'
            
            write_csv_from_dict_list(output_file, output_data, output_headers)
            print(f'✓ Created {output_file} with {len(all_unique_headers)} different columns')
        else:
            print('No column differences found between files.')
            sys.exit(0)
    
    else:  # without_difference
        # Keep only columns that exist in both files
        common_headers = list(set(file1_headers) & set(file2_headers))
        common_headers.sort(key=lambda x: file1_headers.index(x))  # Maintain original order
        
        if common_headers:
            # Create combined data with only common columns
            output_data = []
            
            # Add file1 data
            for row in file1_data:
                new_row = {}
                for col in common_headers:
                    new_row[col] = row.get(col, '')
                output_data.append(new_row)
            
            # Add file2 data
            for row in file2_data:
                new_row = {}
                for col in common_headers:
                    new_row[col] = row.get(col, '')
                output_data.append(new_row)
            
            output_file = base_name + '_without_column_difference.csv'
            write_csv_from_dict_list(output_file, output_data, common_headers)
            print(f'✓ Created {output_file} with {len(common_headers)} common columns and {len(output_data)} rows')
        else:
            print('No common columns found between files.')
            sys.exit(1)

else:  # row-based comparison
    if output_type == 'difference':
        # Find rows that are different between files
        file1_rows_set = set()
        file2_rows_set = set()
        
        # Convert rows to tuples for comparison
        for row in file1_data:
            row_tuple = tuple(sorted(row.items()))
            file1_rows_set.add(row_tuple)
        
        for row in file2_data:
            row_tuple = tuple(sorted(row.items()))
            file2_rows_set.add(row_tuple)
        
        unique_to_file1 = file1_rows_set - file2_rows_set
        unique_to_file2 = file2_rows_set - file1_rows_set
        
        if unique_to_file1 or unique_to_file2:
            output_data = []
            
            # Add unique rows from file1
            for row_tuple in unique_to_file1:
                row_dict = dict(row_tuple)
                row_dict['source_file'] = '$file1'
                output_data.append(row_dict)
            
            # Add unique rows from file2
            for row_tuple in unique_to_file2:
                row_dict = dict(row_tuple)
                row_dict['source_file'] = '$file2'
                output_data.append(row_dict)
            
            output_headers = ['source_file'] + file1_headers
            output_file = base_name + '_row_difference.csv'
            
            write_csv_from_dict_list(output_file, output_data, output_headers)
            print(f'✓ Created {output_file} with {len(output_data)} different rows')
        else:
            print('No row differences found between files.')
            sys.exit(0)
    
    else:  # without_difference
        # Keep only rows that exist in both files
        file1_rows_set = set()
        file2_rows_set = set()
        
        # Convert rows to tuples for comparison
        for row in file1_data:
            row_tuple = tuple(sorted(row.items()))
            file1_rows_set.add(row_tuple)
        
        for row in file2_data:
            row_tuple = tuple(sorted(row.items()))
            file2_rows_set.add(row_tuple)
        
        common_rows = file1_rows_set & file2_rows_set
        
        if common_rows:
            output_data = []
            for row_tuple in common_rows:
                row_dict = dict(row_tuple)
                output_data.append(row_dict)
            
            output_file = base_name + '_without_row_difference.csv'
            write_csv_from_dict_list(output_file, output_data, file1_headers)
            print(f'✓ Created {output_file} with {len(output_data)} common rows')
        else:
            print('No common rows found between files.')
            sys.exit(0)
"
}

# Main script
main() {
    echo "🔍 Scanning for CSV files in current directory..."
    
    # Find all CSV files (compatible with older Bash)
    csv_files=()
    while IFS= read -r -d '' file; do
        csv_files+=("$file")
    done < <(find . -maxdepth 1 -name "*.csv" -type f -print0 | sort -z)
    
    local num_files=${#csv_files[@]}
    
    if [[ $num_files -eq 0 ]]; then
        echo "❌ No CSV files found in current directory."
        exit 1
    elif [[ $num_files -eq 1 ]]; then
        echo "❌ Only 1 CSV file found. Need exactly 2 files for comparison."
        echo "   Found: ${csv_files[0]}"
        exit 1
    elif [[ $num_files -gt 2 ]]; then
        echo "❌ Found $num_files CSV files. Need exactly 2 files for comparison."
        echo "   Found files:"
        printf '     %s\n' "${csv_files[@]}"
        exit 1
    fi
    
    local file1="${csv_files[0]}"
    local file2="${csv_files[1]}"
    
    echo "📁 Found exactly 2 CSV files:"
    echo "   File 1: $file1"
    echo "   File 2: $file2"
    echo
    
    # Check if files are readable
    if [[ ! -r "$file1" ]]; then
        echo "❌ Cannot read $file1"
        exit 1
    fi
    
    if [[ ! -r "$file2" ]]; then
        echo "❌ Cannot read $file2"
        exit 1
    fi
    
    # Get and compare headers
    local header1=$(get_header "$file1")
    local header2=$(get_header "$file2")
    
    echo "🔍 Checking headers..."
    echo "   File 1 header: $header1"
    echo "   File 2 header: $header2"
    echo
    
    if [[ "$header1" != "$header2" ]]; then
        echo "❌ Headers are not identical!"
        echo "   The CSV files must have the same column names in the same order."
        echo "   Please ensure both files have identical headers before running this script."
        exit 1
    fi
    
    echo "✅ Headers are identical. Proceeding with comparison..."
    echo
    
    # Prompt for comparison type
    echo "Choose comparison type:"
    echo "  1) Column differences (compare which columns are unique to each file)"
    echo "  2) Row differences (compare which rows are unique to each file)"
    echo
    
    while true; do
        read -p "Enter your choice (1-2): " -r choice
        case $choice in
            1)
                diff_type="column"
                break
                ;;
            2)
                diff_type="row"
                break
                ;;
            *)
                echo "❌ Invalid choice. Please enter 1 or 2."
                ;;
        esac
    done
    
    echo
    
    # Prompt for output type
    echo "Choose output type:"
    echo "  1) Show differences (export only the different ${diff_type}s)"
    echo "  2) Show without differences (export only the common ${diff_type}s)"
    echo
    
    while true; do
        read -p "Enter your choice (1-2): " -r choice
        case $choice in
            1)
                output_type="difference"
                break
                ;;
            2)
                output_type="without_difference"
                break
                ;;
            *)
                echo "❌ Invalid choice. Please enter 1 or 2."
                ;;
        esac
    done
    
    echo
    
    # Generate base name for output file
    local base_name=$(longest_common_substring "$file1" "$file2")
    
    echo "📝 Processing files..."
    echo "   Comparison type: $diff_type"
    echo "   Output type: $output_type"
    echo "   Base name: $base_name"
    echo
    
    # Perform the comparison
    compare_csv_files "$file1" "$file2" "$diff_type" "$output_type" "$base_name"
    
    echo "🎉 Comparison completed successfully!"
}

# Run main function
main "$@"