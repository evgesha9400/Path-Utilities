#!/bin/bash

# CSV Difference Script
# Compares two CSV files and outputs differrent or similar rows

set -e  # Exit on any error

# Source the file selector component
source "$(dirname "$0")/file_selector"

# Function to get CSV header
get_header() {
    head -n 1 "$1"
}

# Function to normalize column names for comparison
normalize_columns() {
    echo "$1" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sort | paste -sd ','
}

# Function to count rows in a file
count_rows() {
    # Count lines after header, handling files that may not end with newline
    local line_count=$(tail -n +2 "$1" | wc -l | tr -d ' ')
    
    # Check if the last line doesn't end with a newline
    if [[ -s "$1" ]] && [[ $(tail -c 1 "$1" | wc -l) -eq 0 ]]; then
        # If the file doesn't end with a newline, add 1 to the count
        echo $((line_count + 1))
    else
        # If the file ends with a newline, return the count as is
        echo "$line_count"
    fi
}

# Function to display a progress bar
show_progress() {
    local current=$1
    local total=$2
    local width=50
    local percentage=$((current * 100 / total))
    local completed=$((width * current / total))
    local remaining=$((width - completed))
    
    printf "\r[%s%s] %d%%" "$(printf "%${completed}s" | tr ' ' '#')" "$(printf "%${remaining}s" | tr ' ' '.')" "$percentage"
}

# Function to find common columns between two headers
find_common_columns() {
    python3 -c "
import sys
import csv
import io

header1 = '$1'.split(',')
header2 = '$2'.split(',')

# Strip whitespace from column names
header1 = [col.strip() for col in header1]
header2 = [col.strip() for col in header2]

# Find common columns
common_cols = []
for col in header1:
    if col in header2:
        common_cols.append(col)

# Print common columns as CSV
if common_cols:
    print(','.join(common_cols))
else:
    print('')
"
}

# Function to find columns that exist in first header but not in second
find_unique_columns() {
    python3 -c "
import sys
import csv
import io

header1 = '$1'.split(',')
header2 = '$2'.split(',')

# Strip whitespace from column names
header1 = [col.strip() for col in header1]
header2 = [col.strip() for col in header2]

# Find unique columns in header1
unique_cols = []
for col in header1:
    if col not in header2:
        unique_cols.append(col)

# Print unique columns as CSV
if unique_cols:
    print(','.join(unique_cols))
else:
    print('')
"
}

# Function to compare two CSV files based on common columns
compare_csv() {
    python3 -c "
import sys
import csv
import io
import os

file1 = '$1'
file2 = '$2'
common_cols = '$3'.split(',')
mode = '$4'
output_file = '$5'

# Strip whitespace from column names
common_cols = [col.strip() for col in common_cols]

# Function to create a key from a row based on common columns
def make_key(row, cols):
    return '|'.join([str(row.get(col, '')) for col in cols])

# Read the first file
rows1 = {}
with open(file1, 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        key = make_key(row, common_cols)
        rows1[key] = row

# Read the second file
rows2 = {}
with open(file2, 'r') as f:
    reader = csv.DictReader(f)
    fieldnames = reader.fieldnames
    for row in reader:
        key = make_key(row, common_cols)
        rows2[key] = row

# Find common and unique keys
keys1 = set(rows1.keys())
keys2 = set(rows2.keys())
common_keys = keys1.intersection(keys2)
only_in_file1 = keys1 - keys2
only_in_file2 = keys2 - keys1

# Get all fieldnames from both files
all_fieldnames = set()
with open(file1, 'r') as f:
    reader = csv.DictReader(f)
    for field in reader.fieldnames:
        all_fieldnames.add(field)

with open(file2, 'r') as f:
    reader = csv.DictReader(f)
    for field in reader.fieldnames:
        all_fieldnames.add(field)

all_fieldnames = list(all_fieldnames)

# Process based on mode
if mode == 'diff':
    # Rows in file1 but not in file2
    with open(output_file, 'w') as f:
        writer = csv.DictWriter(f, fieldnames=all_fieldnames)
        writer.writeheader()
        for key in only_in_file1:
            writer.writerow(rows1[key])
    
    print(f'{len(only_in_file1)} rows in {os.path.basename(file1)} but not in {os.path.basename(file2)}')
    
elif mode == 'common':
    # Rows in both files
    with open(output_file, 'w') as f:
        writer = csv.DictWriter(f, fieldnames=all_fieldnames)
        writer.writeheader()
        for key in common_keys:
            # Merge the rows from both files
            merged_row = {}
            for field in all_fieldnames:
                if field in rows1[key]:
                    merged_row[field] = rows1[key][field]
                elif field in rows2[key]:
                    merged_row[field] = rows2[key][field]
                else:
                    merged_row[field] = ''
            writer.writerow(merged_row)
    
    print(f'{len(common_keys)} rows common to both files')
    
elif mode == 'unique':
    # Rows unique to each file
    with open(output_file, 'w') as f:
        writer = csv.DictWriter(f, fieldnames=all_fieldnames)
        writer.writeheader()
        for key in only_in_file1:
            writer.writerow(rows1[key])
        for key in only_in_file2:
            writer.writerow(rows2[key])
    
    print(f'{len(only_in_file1)} rows only in {os.path.basename(file1)}')
    print(f'{len(only_in_file2)} rows only in {os.path.basename(file2)}')
    print(f'Total: {len(only_in_file1) + len(only_in_file2)} unique rows')
    
elif mode == 'file2_only':
    # Rows in file2 but not in file1
    with open(output_file, 'w') as f:
        writer = csv.DictWriter(f, fieldnames=all_fieldnames)
        writer.writeheader()
        for key in only_in_file2:
            writer.writerow(rows2[key])
    
    print(f'{len(only_in_file2)} rows in {os.path.basename(file2)} but not in {os.path.basename(file1)}')

# Return success
sys.exit(0)
"
}

# Note: The file selection functionality has been moved to the file_selector component

# Main script
main() {
    echo "🔍 Scanning for CSV files in current directory..."
    
    # Find all CSV files (compatible with older Bash)
    local all_csv_files=()
    while IFS= read -r -d '' file; do
        all_csv_files+=("$file")
    done < <(find . -maxdepth 1 -name "*.csv" -type f -print0 | sort -z)
    
    if [[ ${#all_csv_files[@]} -eq 0 ]]; then
        echo "❌ No CSV files found in current directory."
        exit 1
    fi
    
    if [[ ${#all_csv_files[@]} -eq 1 ]]; then
        echo "❌ Only one CSV file found. Need at least 2 files for comparison."
        exit 1
    fi
    
    # Let user select files using the file_selector component
    select_files "CSV File Selection" 2 2 "*.csv" "."
    if [[ $? -ne 0 ]]; then
        exit 1
    fi
    
    # Copy selected_files to csv_files for compatibility with the rest of the script
    csv_files=("${selected_files[@]}")
    
    local file1="${csv_files[0]}"
    local file2="${csv_files[1]}"
    
    echo "📁 Selected ${#csv_files[@]} files:"
    for file in "${csv_files[@]}"; do
        printf '   %s\n' "$(echo "$file" | sed 's|^\./||')"
    done
    echo
    
    # Check if files are readable
    if [[ ! -r "$file1" ]]; then
        echo "❌ Cannot read $file1"
        exit 1
    fi
    
    if [[ ! -r "$file2" ]]; then
        echo "❌ Cannot read $file2"
        exit 1
    fi
    
    # Get and compare headers
    local header1=$(get_header "$file1")
    local header2=$(get_header "$file2")
    
    echo "🔍 Analyzing CSV files..."
    echo "   File 1: $(basename "$file1")"
    echo "   File 2: $(basename "$file2")"
    echo
    
    # Find common columns
    local common_columns=$(find_common_columns "$header1" "$header2")
    if [[ -z "$common_columns" ]]; then
        echo "❌ No common columns found between the files."
        exit 1
    fi
    
    # Find unique columns in each file
    local unique_to_file1=$(find_unique_columns "$header1" "$header2")
    local unique_to_file2=$(find_unique_columns "$header2" "$header1")
    
    echo "📊 Column Analysis:"
    echo "   Common columns: $(echo "$common_columns" | tr ',' ', ')"
    echo
    
    if [[ -n "$unique_to_file1" ]]; then
        echo "   Columns only in $(basename "$file1"): $(echo "$unique_to_file1" | tr ',' ', ')"
    fi
    
    if [[ -n "$unique_to_file2" ]]; then
        echo "   Columns only in $(basename "$file2"): $(echo "$unique_to_file2" | tr ',' ', ')"
    fi
    echo
    
    # Count rows in each file
    local rows1=$(count_rows "$file1")
    local rows2=$(count_rows "$file2")
    
    echo "📝 Row counts:"
    echo "   $(basename "$file1"): $rows1 data rows"
    echo "   $(basename "$file2"): $rows2 data rows"
    echo
    
    # Ask user for comparison mode
    echo "Select comparison mode:"
    echo "1) Find rows in file 1 that are NOT in file 2"
    echo "2) Find rows in file 2 that are NOT in file 1"
    echo "3) Find rows that exist in BOTH files"
    echo "4) Find rows that are UNIQUE to each file"
    echo
    
    read -p "Enter choice (1-4): " -r mode_choice
    echo
    
    local mode=""
    local output_file=""
    local base_name1=$(basename "$file1" .csv)
    local base_name2=$(basename "$file2" .csv)
    
    case "$mode_choice" in
        1)
            mode="diff"
            output_file="${base_name1}_not_in_${base_name2}.csv"
            ;;
        2)
            mode="file2_only"
            output_file="${base_name2}_not_in_${base_name1}.csv"
            ;;
        3)
            mode="common"
            output_file="${base_name1}_and_${base_name2}_common.csv"
            ;;
        4)
            mode="unique"
            output_file="${base_name1}_and_${base_name2}_unique.csv"
            ;;
        *)
            echo "❌ Invalid choice."
            exit 1
            ;;
    esac
    
    # Check if output file exists
    if [[ -e "$output_file" ]]; then
        read -p "⚠️  Output file '$output_file' already exists. Overwrite? (y/N): " -r confirm
        echo
        if [[ ! $confirm =~ ^[Yy]$ ]]; then
            echo "❌ Operation cancelled."
            exit 1
        fi
    fi
    
    echo "🔍 Comparing files based on common columns..."
    echo "   Using columns: $(echo "$common_columns" | tr ',' ', ')"
    echo "   Output file: $output_file"
    echo
    
    # Perform the comparison
    compare_csv "$file1" "$file2" "$common_columns" "$mode" "$output_file"
    
    echo
    echo "✅ Comparison complete! Results saved to $output_file"
}

# Run main function
main "$@"