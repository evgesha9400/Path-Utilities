#!/bin/bash

# CSV Column Merge Script
# Merges two columns in CSV files with conflict resolution options

set -e  # Exit on any error

# Function to list CSV files in current directory
list_csv_files() {
    python3 -c "
import os
import sys

csv_files = []
for file in os.listdir('.'):
    if file.lower().endswith('.csv'):
        csv_files.append(file)

csv_files.sort()

if not csv_files:
    print('No CSV files found in the current directory.')
    sys.exit(1)

print('CSV files found:')
for i, file in enumerate(csv_files, 1):
    print(f'{i:2d}) {file}')

# Output for bash processing
print('||CSV_FILES||')
for i, file in enumerate(csv_files, 1):
    print(f'{i}|{file}')
"
}

# Function to get column names from CSV
get_columns() {
    python3 -c "
import csv
import sys

filename = '$1'

try:
    with open(filename, 'r', encoding='utf-8') as f:
        # Detect delimiter
        sample = f.read(1024)
        f.seek(0)
        sniffer = csv.Sniffer()
        delimiter = sniffer.sniff(sample).delimiter
        
        reader = csv.reader(f, delimiter=delimiter)
        headers = next(reader)
        
        print('Columns:')
        for i, header in enumerate(headers, 1):
            print(f'{i:2d}) {header.strip()}')
        
        # Output for bash processing
        print('||COLUMNS||')
        for i, header in enumerate(headers, 1):
            print(f'{i}|{header.strip()}')
        print(f'||DELIMITER||{repr(delimiter)}')
        
except Exception as e:
    print(f'Error reading CSV file: {e}', file=sys.stderr)
    sys.exit(1)
"
}

# Function to analyze conflicts between two columns
analyze_conflicts() {
    local filename="$1"
    local col1_idx="$2"
    local col2_idx="$3"
    
    python3 -c "
import csv
import sys

filename = '$filename'
col1_idx = int('$col1_idx')
col2_idx = int('$col2_idx')

try:
    with open(filename, 'r', encoding='utf-8') as f:
        # Detect delimiter
        sample = f.read(1024)
        f.seek(0)
        sniffer = csv.Sniffer()
        delimiter = sniffer.sniff(sample).delimiter
        
        reader = csv.reader(f, delimiter=delimiter)
        headers = next(reader)
        
        conflicts = []
        total_rows = 0
        
        for row_idx, row in enumerate(reader):
            total_rows += 1
            
            # Ensure row has enough columns
            while len(row) <= max(col1_idx, col2_idx):
                row.append('')
            
            val1 = row[col1_idx].strip() if col1_idx < len(row) else ''
            val2 = row[col2_idx].strip() if col2_idx < len(row) else ''
            
            # Conflict: both non-empty with different values
            if val1 and val2 and val1 != val2:
                conflicts.append(row_idx)
        
        col1_name = headers[col1_idx].strip()
        col2_name = headers[col2_idx].strip()
        
        print(f'Merging columns: \"{col1_name}\" and \"{col2_name}\"')
        print()
        print('Conflict analysis:')
        print(f'Total data rows: {total_rows}')
        print(f'Rows with conflicts: {len(conflicts)}')
        
        if len(conflicts) == 0:
            print('No conflicts detected - columns can be merged safely')
        else:
            print(f'Found {len(conflicts)} rows where both columns have different non-empty values')
        
        # Output for bash processing
        print('||ANALYSIS||')
        print(f'conflicts={len(conflicts)}')
        print(f'total_rows={total_rows}')
        print(f'col1_name={col1_name}')
        print(f'col2_name={col2_name}')
        for conflict_row in conflicts:
            print(f'conflict_row={conflict_row}')
        
except Exception as e:
    print(f'Error analyzing conflicts: {e}', file=sys.stderr)
    sys.exit(1)
"
}

# Function to perform the column merge
merge_columns() {
    local filename="$1"
    local col1_idx="$2"
    local col2_idx="$3"
    local method="$4"
    local new_col_name="$5"
    local output_file="$6"
    shift 6
    local conflict_rows=("$@")
    
    python3 -c "
import csv
import sys
import os

filename = '$filename'
col1_idx = int('$col1_idx')
col2_idx = int('$col2_idx')
method = '$method'
new_col_name = '$new_col_name'
output_file = '$output_file'
conflict_rows = set()

# Parse conflict rows from arguments
for arg in sys.argv[1:]:
    if arg.isdigit():
        conflict_rows.add(int(arg))

def resolve_conflict_interactive(row_idx, val1, val2, col1_name, col2_name):
    print(f'\\nConflict in row {row_idx + 2}:')  # +2 because row 1 is header
    print(f'Column \"{col1_name}\": \"{val1}\"')
    print(f'Column \"{col2_name}\": \"{val2}\"')
    print('1) Use Column 1 value')
    print('2) Use Column 2 value')
    print('3) Enter custom value')
    
    while True:
        try:
            choice = input('Choose resolution (enter number): ').strip()
            if choice == '1':
                return val1
            elif choice == '2':
                return val2
            elif choice == '3':
                custom_value = input('Enter custom value: ')
                return custom_value
            else:
                print('Please enter 1, 2, or 3')
        except (EOFError, KeyboardInterrupt):
            print('\\nOperation cancelled.')
            sys.exit(0)

try:
    with open(filename, 'r', encoding='utf-8') as f:
        # Detect delimiter
        sample = f.read(1024)
        f.seek(0)
        sniffer = csv.Sniffer()
        delimiter = sniffer.sniff(sample).delimiter
        
        reader = csv.reader(f, delimiter=delimiter)
        headers = next(reader)
        data = list(reader)
    
    col1_name = headers[col1_idx].strip()
    col2_name = headers[col2_idx].strip()
    
    # Create new headers (remove one column, rename the other)
    new_headers = headers.copy()
    # Remove the higher index first to maintain lower index validity
    higher_idx = max(col1_idx, col2_idx)
    lower_idx = min(col1_idx, col2_idx)
    
    new_headers.pop(higher_idx)
    new_headers[lower_idx] = new_col_name
    
    # Process data
    new_data = []
    
    for row_idx, row in enumerate(data):
        new_row = row.copy()
        
        # Ensure row has enough columns
        while len(new_row) <= max(col1_idx, col2_idx):
            new_row.append('')
        
        val1 = new_row[col1_idx].strip()
        val2 = new_row[col2_idx].strip()
        
        # Determine merged value
        if row_idx in conflict_rows and method == 'prompt_per_conflict':
            merged_value = resolve_conflict_interactive(row_idx, val1, val2, col1_name, col2_name)
        elif val1 and val2 and val1 != val2:  # Conflict
            if method == 'col1_precedence':
                merged_value = val1
            elif method == 'col2_precedence':
                merged_value = val2
            elif method == 'prompt_per_conflict':
                merged_value = resolve_conflict_interactive(row_idx, val1, val2, col1_name, col2_name)
            else:
                merged_value = val1  # fallback
        elif val1:
            merged_value = val1
        elif val2:
            merged_value = val2
        else:
            merged_value = ''
        
        # Create new row with merged column
        new_row[lower_idx] = merged_value
        new_row.pop(higher_idx)
        
        new_data.append(new_row)
    
    # Save the result
    with open(output_file, 'w', encoding='utf-8', newline='') as f:
        writer = csv.writer(f, delimiter=delimiter)
        writer.writerow(new_headers)
        writer.writerows(new_data)
    
    print(f'Merge completed! New column: \"{new_col_name}\"')
    print(f'CSV now has {len(new_headers)} columns')
    
except Exception as e:
    print(f'Error during merge: {e}', file=sys.stderr)
    sys.exit(1)
" "${conflict_rows[@]}"
}

# Function to select a file from the list
select_csv_file() {
    echo "CSV Column Merge Tool" >&2
    echo "==========================" >&2
    echo >&2
    
    # Get list of CSV files
    csv_output=$(list_csv_files)
    # Display only the user-friendly part (before the delimiter)
    echo "$csv_output" | sed '/||CSV_FILES||/,$d' >&2
    
    # Extract file list for processing
    csv_files=()
    while IFS= read -r line; do
        if [[ $line == "||CSV_FILES||"* ]]; then
            continue
        elif [[ $line == *"|"* ]]; then
            file=$(echo "$line" | cut -d'|' -f2)
            csv_files+=("$file")
        fi
    done <<< "$csv_output"
    
    if [ ${#csv_files[@]} -eq 0 ]; then
        echo "No CSV files found in the current directory." >&2
        exit 1
    fi
    
    # Get user selection
    while true; do
        echo >&2
        read -p "Select a CSV file (enter number): " choice
        
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#csv_files[@]} ]; then
            selected_file="${csv_files[$((choice-1))]}"
            echo >&2
            echo "Selected file: $selected_file" >&2
            break
        else
            echo "Please enter a number between 1 and ${#csv_files[@]}" >&2
        fi
    done
    
    echo "$selected_file"
}

# Function to select two columns for merging
select_columns() {
    local filename="$1"
    
    # Get column information
    columns_output=$(get_columns "$filename")
    # Display only the user-friendly part (before the delimiter)
    echo "$columns_output" | sed '/||COLUMNS||/,$d' >&2
    
    # Extract column data for processing
    columns=()
    delimiter=""
    while IFS= read -r line; do
        if [[ $line == "||COLUMNS||"* ]]; then
            continue
        elif [[ $line == "||DELIMITER||"* ]]; then
            delimiter=$(echo "$line" | cut -d'|' -f2)
            delimiter=$(echo "$delimiter" | sed "s/^'//; s/'$//")  # Remove quotes
        elif [[ $line == *"|"* ]]; then
            col_name=$(echo "$line" | cut -d'|' -f2)
            columns+=("$col_name")
        fi
    done <<< "$columns_output"
    
    if [ ${#columns[@]} -lt 2 ]; then
        echo "Error: Need at least 2 columns to merge" >&2
        exit 1
    fi
    
    # Select first column
    while true; do
        echo >&2
        read -p "Select first column to merge (enter number): " col1_choice
        
        if [[ "$col1_choice" =~ ^[0-9]+$ ]] && [ "$col1_choice" -ge 1 ] && [ "$col1_choice" -le ${#columns[@]} ]; then
            col1_idx=$((col1_choice-1))
            col1_name="${columns[$col1_idx]}"
            break
        else
            echo "Please enter a number between 1 and ${#columns[@]}" >&2
        fi
    done
    
    # Select second column
    while true; do
        read -p "Select second column to merge (enter number): " col2_choice
        
        if [[ "$col2_choice" =~ ^[0-9]+$ ]] && [ "$col2_choice" -ge 1 ] && [ "$col2_choice" -le ${#columns[@]} ]; then
            col2_idx=$((col2_choice-1))
            col2_name="${columns[$col2_idx]}"
            
            if [ "$col1_idx" -eq "$col2_idx" ]; then
                echo "Please select two different columns" >&2
                continue
            fi
            break
        else
            echo "Please enter a number between 1 and ${#columns[@]}" >&2
        fi
    done
    
    echo "$col1_idx $col2_idx"
}

# Function to select merge method
select_merge_method() {
    local col1_name="$1"
    local col2_name="$2"
    
    echo >&2
    echo "Merge methods:" >&2
    echo "1) '$col1_name' takes precedence over '$col2_name'" >&2
    echo "2) '$col2_name' takes precedence over '$col1_name'" >&2
    echo "3) Prompt at every conflict (choose per conflict)" >&2
    
    while true; do
        echo >&2
        read -p "Select merge method (enter number): " method_choice
        
        case "$method_choice" in
            1)
                echo "col1_precedence"
                break
                ;;
            2)
                echo "col2_precedence"
                break
                ;;
            3)
                echo "prompt_per_conflict"
                break
                ;;
            *)
                echo "Please enter 1, 2, or 3" >&2
                ;;
        esac
    done
}

# Function to select column name
select_column_name() {
    local col1_name="$1"
    local col2_name="$2"
    
    echo
    echo "Column naming options:"
    echo "1) Keep Column 1 name: '$col1_name'"
    echo "2) Keep Column 2 name: '$col2_name'"
    echo "3) Enter a custom name"
    
    while true; do
        echo
        read -p "Select naming option (enter number): " name_choice
        
        case "$name_choice" in
            1)
                echo "$col1_name"
                break
                ;;
            2)
                echo "$col2_name"
                break
                ;;
            3)
                while true; do
                    read -p "Enter custom column name: " custom_name
                    if [ -n "$custom_name" ]; then
                        echo "$custom_name"
                        break 2
                    else
                        echo "Column name cannot be empty"
                    fi
                done
                ;;
            *)
                echo "Please enter 1, 2, or 3"
                ;;
        esac
    done
}

# Main script execution
main() {
    # Select CSV file
    selected_file=$(select_csv_file)
    
    # Load CSV data and get total rows
    columns_output=$(get_columns "$selected_file")
    total_rows=$(echo "$columns_output" | grep -E '^[0-9]+\)' | wc -l)
    data_rows=$(python3 -c "
import csv
with open('$selected_file', 'r', encoding='utf-8') as f:
    reader = csv.reader(f)
    next(reader)  # skip header
    print(sum(1 for row in reader))
")
    
    echo "Loaded CSV with $total_rows columns and $data_rows rows"
    
    while true; do
        # Select columns to merge
        column_selection=$(select_columns "$selected_file")
        col1_idx=$(echo "$column_selection" | cut -d' ' -f1)
        col2_idx=$(echo "$column_selection" | cut -d' ' -f2)
        
        echo
        
        # Analyze conflicts
        analysis_output=$(analyze_conflicts "$selected_file" "$col1_idx" "$col2_idx")
        echo "$analysis_output"
        
        # Extract analysis data
        num_conflicts=0
        col1_name=""
        col2_name=""
        conflict_rows=()
        
        while IFS= read -r line; do
            if [[ $line == "||ANALYSIS||"* ]]; then
                continue
            elif [[ $line == conflicts=* ]]; then
                num_conflicts=$(echo "$line" | cut -d'=' -f2)
            elif [[ $line == col1_name=* ]]; then
                col1_name=$(echo "$line" | cut -d'=' -f2)
            elif [[ $line == col2_name=* ]]; then
                col2_name=$(echo "$line" | cut -d'=' -f2)
            elif [[ $line == conflict_row=* ]]; then
                conflict_row=$(echo "$line" | cut -d'=' -f2)
                conflict_rows+=("$conflict_row")
            fi
        done <<< "$analysis_output"
        
        # Select merge method
        method=$(select_merge_method "$col1_name" "$col2_name")
        
        # Select column name
        new_col_name=$(select_column_name "$col1_name" "$col2_name")
        
        # Generate output filename
        base_name=$(basename "$selected_file" .csv)
        output_file="${base_name}_Merged.csv"
        
        echo
        
        # Perform merge
        merge_columns "$selected_file" "$col1_idx" "$col2_idx" "$method" "$new_col_name" "$output_file" "${conflict_rows[@]}"
        
        # Update selected_file to the merged file for potential next iteration
        selected_file="$output_file"
        
        # Ask if user wants to merge more columns
        echo
        while true; do
            read -p "Do you want to merge two more columns? (y/n): " continue_choice
            case "$continue_choice" in
                [Yy]|[Yy][Ee][Ss])
                    # Check if enough columns remain
                    remaining_cols=$(python3 -c "
import csv
with open('$selected_file', 'r', encoding='utf-8') as f:
    reader = csv.reader(f)
    headers = next(reader)
    print(len(headers))
")
                    if [ "$remaining_cols" -lt 2 ]; then
                        echo "Not enough columns left to merge (need at least 2)"
                        continue_choice="n"
                    fi
                    break
                    ;;
                [Nn]|[Nn][Oo])
                    break
                    ;;
                *)
                    echo "Please enter 'y' or 'n'"
                    ;;
            esac
        done
        
        if [[ "$continue_choice" =~ ^[Nn] ]]; then
            break
        fi
        
        echo
        echo "Current file: $selected_file"
    done
    
    echo
    echo "Final merged CSV saved as: $output_file"
}

# Run the main function
main