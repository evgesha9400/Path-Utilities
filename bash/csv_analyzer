#!/bin/bash

# csv_analyzer - Simple Bash Wrapper
# Redirects to Python script with all arguments

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Set PYTHONPATH to include the src directory so Python can find the shared module
export PYTHONPATH="$SCRIPT_DIR/../src:$PYTHONPATH"

# Execute the Python script with all arguments passed through
exec python3 "$SCRIPT_DIR/../src/csv_analyzer.py" "$@"
