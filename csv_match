#!/bin/bash

# CSV Match Script
# Compares two CSV files with potentially different headers by matching on specified columns
# Exports either matching rows or non-matching rows

set -e  # Exit on any error

# Source the file selector component
source "$(dirname "$0")/shared/file_selector"

# Function to get CSV header
get_header() {
    head -n 1 "$1"
}

# Function to get column names from CSV
get_columns() {
    python3 -c "
import csv
import sys

# Try different encodings
for encoding in ['utf-8', 'latin-1', 'cp1252', 'iso-8859-1']:
    try:
        with open('$1', 'r', encoding=encoding) as f:
            reader = csv.reader(f)
            headers = next(reader)
            for i, header in enumerate(headers):
                print(f'{i+1:2d}) {header.strip()}')
            break  # Successfully read the file
    except UnicodeDecodeError:
        if encoding == 'iso-8859-1':  # Last encoding attempt
            print(f\"❌ Could not decode the file with any of the attempted encodings.\")
            sys.exit(1)
        continue  # Try next encoding
"
}

# Function to find longest common substring for output naming
longest_common_substring() {
    python3 -c "
import sys
s1, s2 = '$1', '$2'

# Remove file extensions for comparison
s1 = s1.replace('.csv', '')
s2 = s2.replace('.csv', '')

max_len = 0
result = ''

for i in range(len(s1)):
    for j in range(i + 1, len(s1) + 1):
        substr = s1[i:j]
        if substr in s2 and len(substr) > max_len:
            max_len = len(substr)
            result = substr

# Clean up the result - remove trailing numbers, underscores, hyphens
import re
result = re.sub(r'[_\-\s]*[0-9]+[_\-\s]*$', '', result)
result = result.strip('_- ')

if result and len(result) >= 3:  # Only use if meaningful length
    print(result)
else:
    # Fallback to first part of first filename
    first_part = s1.split('_')[0].split('-')[0].split(' ')[0]
    print(first_part if first_part else 'match')
"
}

# Function to match CSV files based on specified columns
match_csv_files() {
    local file1="$1"
    local file2="$2"
    local col1_indices="$3"  # comma-separated list of column indices
    local col2_indices="$4"  # comma-separated list of column indices
    local output_type="$5"  # "matching" or "non_matching"
    local export_from="$6"  # "file1" or "file2"
    local base_name="$7"
    local show_summary="$8"  # "true" or "false"
    
    python3 -c "
import csv
import sys
from collections import OrderedDict

def parse_column_indices(indices_str):
    \"\"\"Parse comma-separated column indices and convert to 0-based list\"\"\"
    indices = []
    for idx in indices_str.split(','):
        idx = idx.strip()
        if idx.isdigit():
            indices.append(int(idx) - 1)  # Convert to 0-based
    return indices

def read_csv_with_multi_columns(filename, match_col_indices):
    \"\"\"Read CSV and create composite keys from multiple columns.

    Important: re-initialize buffers on each encoding attempt to avoid
    duplicating partially-read rows when a UnicodeDecodeError occurs mid-read.
    \"\"\"
    encodings = ['utf-8', 'latin-1', 'cp1252', 'iso-8859-1']
    
    for encoding in encodings:
        data = []
        match_values = set()
        try:
            with open(filename, 'r', encoding=encoding, newline='') as f:
                reader = csv.reader(f)
                headers = next(reader)

                for row_num, row in enumerate(reader):
                    # Pad row if it has fewer columns than headers
                    while len(row) < len(headers):
                        row.append('')

                    # Build row dict preserving header order
                    row_dict = {}
                    for i, header in enumerate(headers):
                        row_dict[header.strip()] = row[i] if i < len(row) else ''
                    data.append(row_dict)

                    # Composite match key
                    match_components = []
                    for col_idx in match_col_indices:
                        if col_idx < len(row):
                            match_components.append(row[col_idx].strip())
                        else:
                            match_components.append('')

                    match_key = '§§§'.join(match_components)
                    if any(comp for comp in match_components):
                        match_values.add(match_key)

                return data, headers, match_values
        except UnicodeDecodeError:
            if encoding == encodings[-1]:
                print(f\"❌ Could not decode {filename} with any of the attempted encodings.\")
                sys.exit(1)
            continue  # Try next encoding

def write_csv_from_dict_list(filename, data, fieldnames):
    with open(filename, 'w', encoding='utf-8', newline='') as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(data)

def get_column_names(headers, indices):
    \"\"\"Get column names for given indices\"\"\"
    names = []
    for idx in indices:
        if idx < len(headers):
            names.append(headers[idx].strip())
        else:
            names.append(f'Column_{idx+1}')
    return names

# Parse column indices
col1_indices = parse_column_indices('$col1_indices')
col2_indices = parse_column_indices('$col2_indices')

# Read both files
file1_data, file1_headers, file1_match_values = read_csv_with_multi_columns('$file1', col1_indices)
file2_data, file2_headers, file2_match_values = read_csv_with_multi_columns('$file2', col2_indices)

output_type = '$output_type'
export_from = '$export_from'
base_name = '$base_name'
show_summary = '$show_summary'

# Get column names for reference
col1_names = get_column_names(file1_headers, col1_indices)
col2_names = get_column_names(file2_headers, col2_indices)

print(f'Matching on:')
if len(col1_indices) == 1:
    print(f'  File 1 column: {col1_names[0]}')
else:
    print(f'  File 1 columns: {\" + \".join(col1_names)} (combined in order)')

if len(col2_indices) == 1:
    print(f'  File 2 column: {col2_names[0]}')
else:
    print(f'  File 2 columns: {\" + \".join(col2_names)} (combined in order)')

print(f'  Exporting from: {\"File 1\" if export_from == \"file1\" else \"File 2\"}')
print(f'  Column order: Preserved as specified (important for multi-column matching)')
print()

# Determine which file's data and headers to use for export
if export_from == 'file1':
    export_data = file1_data
    export_headers = file1_headers
    export_match_indices = col1_indices
    reference_match_values = file2_match_values
    export_file_name = '$file1'
else:
    export_data = file2_data
    export_headers = file2_headers
    export_match_indices = col2_indices
    reference_match_values = file1_match_values
    export_file_name = '$file2'

# Calculate matching and non-matching counts
matching_count = 0
non_matching_count = 0

for row in export_data:
    # Create composite match key from export file
    row_values = list(row.values())
    match_components = []
    for col_idx in export_match_indices:
        if col_idx < len(row_values):
            match_components.append(row_values[col_idx].strip())
        else:
            match_components.append('')
    
    match_key = '§§§'.join(match_components)
    
    # Check if this key exists in reference file
    if match_key and match_key in reference_match_values:
        matching_count += 1
    else:
        non_matching_count += 1

# Show summary if requested or in summary_only mode
if show_summary in ['true', 'summary_only']:
    print('📊 SUMMARY:')
    print(f'  Total rows in export file: {len(export_data)}')
    print(f'  Unique match keys in File 1: {len(file1_match_values)}')
    print(f'  Unique match keys in File 2: {len(file2_match_values)}')
    print(f'  Rows with matches: {matching_count}')
    print(f'  Rows without matches: {non_matching_count}')
    if output_type == 'matching':
        print(f'  → Will export {matching_count} matching rows')
    else:
        print(f'  → Will export {non_matching_count} non-matching rows')
    print()

# Exit early if this is summary_only mode
if show_summary == 'summary_only':
    sys.exit(0)

if output_type == 'matching':
    # Find rows in export file that have matching values in reference file
    matching_rows = []
    
    for row in export_data:
        # Create composite match key from export file
        row_values = list(row.values())
        match_components = []
        for col_idx in export_match_indices:
            if col_idx < len(row_values):
                match_components.append(row_values[col_idx].strip())
            else:
                match_components.append('')
        
        match_key = '§§§'.join(match_components)
        
        # Check if this key exists in reference file
        if match_key and match_key in reference_match_values:
            matching_rows.append(row)
    
    if matching_rows:
        # Create filename with source file basename
        source_basename = export_file_name.replace('.csv', '').replace('./', '')
        output_file = f'{source_basename}_matching_rows.csv'
        write_csv_from_dict_list(output_file, matching_rows, export_headers)
        print(f'✓ Created {output_file} with {len(matching_rows)} matching rows from {export_file_name}')
    else:
        print(f'No matching rows found in {export_file_name}.')
        sys.exit(0)

else:  # non_matching
    # Find rows in export file that do NOT have matching values in reference file
    non_matching_rows = []
    
    for row in export_data:
        # Create composite match key from export file
        row_values = list(row.values())
        match_components = []
        for col_idx in export_match_indices:
            if col_idx < len(row_values):
                match_components.append(row_values[col_idx].strip())
            else:
                match_components.append('')
        
        match_key = '§§§'.join(match_components)
        
        # Check if this key does NOT exist in reference file
        if not match_key or match_key not in reference_match_values:
            non_matching_rows.append(row)
    
    if non_matching_rows:
        # Create filename with source file basename
        source_basename = export_file_name.replace('.csv', '').replace('./', '')
        output_file = f'{source_basename}_non_matching_rows.csv'
        write_csv_from_dict_list(output_file, non_matching_rows, export_headers)
        print(f'✓ Created {output_file} with {len(non_matching_rows)} non-matching rows from {export_file_name}')
    else:
        print(f'All rows in {export_file_name} have matches in the other file.')
        sys.exit(0)
"
}

# Note: The file selection functionality has been moved to the file_selector component

# Main script
main() {
    echo "🔍 Scanning for CSV files in current directory..."
    
    # Find all CSV files (compatible with zsh)
    local all_csv_files=()
    while IFS= read -r -d '' file; do
        all_csv_files+=("$file")
    done < <(find . -maxdepth 1 -name "*.csv" -type f -print0 | sort -z)
    
    if [[ ${#all_csv_files[@]} -eq 0 ]]; then
        echo "❌ No CSV files found in current directory."
        exit 1
    fi
    
    if [[ ${#all_csv_files[@]} -eq 1 ]]; then
        echo "❌ Only one CSV file found. Need at least 2 files for comparison."
        exit 1
    fi
    
    # Let user select files using the file_selector component
    select_files "CSV File Selection" 2 2 "*.csv" "."
    if [[ $? -ne 0 ]]; then
        exit 1
    fi
    
    # Copy selected_files to csv_files for compatibility with the rest of the script
    csv_files=("${selected_files[@]}")
    
    local file1="${csv_files[0]}"
    local file2="${csv_files[1]}"
    
    echo "📁 Selected ${#csv_files[@]} files:"
    for file in "${csv_files[@]}"; do
        printf '   %s\n' "$(basename "$file")"
    done
    echo
    
    # Check if files are readable
    if [[ ! -r "$file1" ]]; then
        echo "❌ Cannot read $(basename "$file1")"
        exit 1
    fi
    
    if [[ ! -r "$file2" ]]; then
        echo "❌ Cannot read $(basename "$file2")"
        exit 1
    fi
    
    # Show headers
    echo "📋 File headers:"
    echo
    echo "File 1: $(basename "$file1")"
    get_columns "$file1"
    echo
    echo "File 2: $(basename "$file2")"
    get_columns "$file2"
    echo
    
# Function to validate column selection
validate_column_selection() {
    local selection="$1"
    local max_cols="$2"
    
    # Check if selection contains only numbers, commas, and spaces
    if [[ ! "$selection" =~ ^[0-9,[:space:]]+$ ]]; then
        return 1
    fi
    
    # Parse and validate each column number
    IFS=',' read -ra COLS <<< "$selection"
    for col in "${COLS[@]}"; do
        col=$(echo "$col" | tr -d '[:space:]')  # Remove spaces
        if [[ ! "$col" =~ ^[0-9]+$ ]] || [[ "$col" -lt 1 ]] || [[ "$col" -gt "$max_cols" ]]; then
            return 1
        fi
    done
    return 0
}

    # Get column selection for file 1
    local num_cols1=$(python3 -c "
import csv
# Try different encodings
for encoding in ['utf-8', 'latin-1', 'cp1252', 'iso-8859-1']:
    try:
        with open('$file1', 'r', encoding=encoding) as f:
            reader = csv.reader(f)
            headers = next(reader)
            print(len(headers))
            break  # Successfully read the file
    except UnicodeDecodeError:
        if encoding == 'iso-8859-1':  # Last encoding attempt
            print(f\"❌ Could not decode the file with any of the attempted encodings.\")
            sys.exit(1)
        continue  # Try next encoding
")
    
    echo "Select column(s) from File 1 to match on:"
    echo "  • For single column: enter column number (e.g.: 3)"
    echo "  • For multiple columns: enter comma-separated numbers (e.g.: 1,3,5)"
    echo "  • Column order matters: matching will preserve the order you specify"
    echo
    
    while true; do
        read -p "Column selection for File 1 (1-$num_cols1): " -r col1_choice
        if validate_column_selection "$col1_choice" "$num_cols1"; then
            # Remove spaces and store
            col1_choice=$(echo "$col1_choice" | tr -d '[:space:]')
            break
        else
            echo "❌ Invalid selection. Please enter valid column numbers between 1 and $num_cols1."
            echo "   Examples: '3' for single column, '1,3,5' for multiple columns"
        fi
    done
    
    # Get column selection for file 2
    local num_cols2=$(python3 -c "
import csv
# Try different encodings
for encoding in ['utf-8', 'latin-1', 'cp1252', 'iso-8859-1']:
    try:
        with open('$file2', 'r', encoding=encoding) as f:
            reader = csv.reader(f)
            headers = next(reader)
            print(len(headers))
            break  # Successfully read the file
    except UnicodeDecodeError:
        if encoding == 'iso-8859-1':  # Last encoding attempt
            print(f\"❌ Could not decode the file with any of the attempted encodings.\")
            sys.exit(1)
        continue  # Try next encoding
")
    
    echo
    echo "Select column(s) from File 2 to match on:"
    echo "  • For single column: enter column number (e.g.: 2)"
    echo "  • For multiple columns: enter comma-separated numbers (e.g.: 2,4,6)"
    echo "  • Column order matters: matching will preserve the order you specify"
    echo
    
    while true; do
        read -p "Column selection for File 2 (1-$num_cols2): " -r col2_choice
        if validate_column_selection "$col2_choice" "$num_cols2"; then
            # Remove spaces and store
            col2_choice=$(echo "$col2_choice" | tr -d '[:space:]')
            break
        else
            echo "❌ Invalid selection. Please enter valid column numbers between 1 and $num_cols2."
            echo "   Examples: '2' for single column, '2,4,6' for multiple columns"
        fi
    done
    
    echo
    
    # Prompt for which file to export from
    echo "Choose which file to export rows from:"
    echo "  1) Export from File 1: $(basename "$file1")"
    echo "  2) Export from File 2: $(basename "$file2")"
    echo
    
    while true; do
        read -p "Enter your choice (1-2): " -r choice
        case $choice in
            1)
                export_from="file1"
                break
                ;;
            2)
                export_from="file2"
                break
                ;;
            *)
                echo "❌ Invalid choice. Please enter 1 or 2."
                ;;
        esac
    done
    
    echo
    
    # Prompt for output type
    echo "Choose output type:"
    echo "  1) Export matching rows (rows that have matches in the other file)"
    echo "  2) Export non-matching rows (rows that do NOT have matches in the other file)"
    echo
    
    while true; do
        read -p "Enter your choice (1-2): " -r choice
        case $choice in
            1)
                output_type="matching"
                break
                ;;
            2)
                output_type="non_matching"
                break
                ;;
            *)
                echo "❌ Invalid choice. Please enter 1 or 2."
                ;;
        esac
    done
    
    echo
    
    # Generate base name for output file
    local base_name=$(longest_common_substring "$file1" "$file2")
    
    echo "📝 Processing files..."
    echo "   Export from: $([ "$export_from" = "file1" ] && basename "$file1" || basename "$file2")"
    echo "   Output type: $output_type"
    echo
    
    # Show summary first
    echo "Analyzing files for matching preview..."
    match_csv_files "$file1" "$file2" "$col1_choice" "$col2_choice" "$output_type" "$export_from" "$base_name" "summary_only"
    
    echo
    while true; do
        read -p "Do you want to proceed with the export? (y/n): " -r proceed_choice
        case $proceed_choice in
            [Yy]|[Yy][Ee][Ss])
                echo
                echo "📝 Exporting matching results..."
                match_csv_files "$file1" "$file2" "$col1_choice" "$col2_choice" "$output_type" "$export_from" "$base_name" "export_only"
                echo "🎉 Matching completed successfully!"
                break
                ;;
            [Nn]|[Nn][Oo])
                echo "Export cancelled."
                exit 0
                ;;
            *)
                echo "❌ Invalid choice. Please enter 'y' for yes or 'n' for no."
                ;;
        esac
    done
}

# Run main function
main "$@"