    echo "You can select multiple columns by separating numbers with commas (e.g., 1,3,4)"
    if [[ "$extend_file" == "file1" ]]; then
        get_columns "$file2"
    else
        get_columns "$file1"
    fi
    echo
    
    echo "Enter column number(s) or search by name (e.g., 'search email' to find email columns)"
    while true; do
        read -p "Enter column number(s) to add (comma-separated, 1-$source_num_cols): " -r input
        
        # Check if it's a search request
        if [[ "$input" =~ ^search ]]; then
            search_term=$(echo "$input" | cut -d' ' -f2- | tr '[:upper:]' '[:lower:]')
            echo "Searching for '$search_term' in source file columns:"
            
            python3 -c "
import csv
with open('$source_file', 'r', encoding='utf-8') as f:
    reader = csv.reader(f)
    headers = next(reader)
    found = False
    for i, header in enumerate(headers):
        if '$search_term' in header.lower():
            print(f'{i+1:2d}) {header.strip()} ✓')
            found = True
    if not found:
        print('No matches found')
"
            echo "Enter column number(s) or try another search"
            continue
        fi
        
        # Process as normal column selection
        add_cols=$(parse_column_numbers "$input" "$source_num_cols")
        if [[ $? -eq 0 ]]; then
            break
        fi
    done
    
    echo
    
    # Choose match type
    echo "Choose matching type:"
    echo "  1) Exact match (values must be identical)"
    echo "  2) Substring match - unidirectional (target value is contained in source value)"
    echo "     Example: 'Apple' matches 'Green Apple Inc'"
    echo "  3) Substring match - bidirectional (either is substring of the other)"
    echo "     Example: 'Apple' matches 'Green Apple Inc' AND 'Green Apple Inc' matches 'Apple'"
    echo
    
    while true; do
        read -p "Enter your choice (1-3): " -r choice
        case $choice in
            1)
                match_type="exact"
                bidirectional="false"
                echo "Selected: Exact matching"
                break
                ;;
            2)
                match_type="substring"
                bidirectional="false"
                echo "Selected: Unidirectional substring matching (target ⊆ source)"
                break
                ;;
            3)
                match_type="substring"
                bidirectional="true"
                echo "Selected: Bidirectional substring matching (target ⊆ source OR source ⊆ target)"
                break
                ;;
            *)
                echo "❌ Invalid choice. Please enter 1, 2, or 3."
                ;;
        esac
    done
    
    echo
    echo "📝 Analyzing match potential..."
    echo
    
    # First, show preview of what will happen
    if [[ "$extend_file" == "file1" ]]; then
        preview_csv_extension "$file1" "$file2" "$target_match_cols" "$source_match_cols" "$extend_file" "$add_cols" "$match_type" "$bidirectional"
    else
        preview_csv_extension "$file1" "$file2" "$source_match_cols" "$target_match_cols" "$extend_file" "$add_cols" "$match_type" "$bidirectional"
    fi
    
    # Ask for confirmation
    echo "❓ Do you want to proceed with the extension?"
    echo "   This will create a new file: $(basename "${target_file%.*}_extended.csv" | sed 's|^\./||')"
    echo
    
    while true; do
        read -p "Continue? (y/n): " -r choice
        case $choice in
            [Yy]*)
                echo
                echo "📝 Creating extended CSV file..."
                break
                ;;
            [Nn]*)
                echo "❌ Extension cancelled."
                exit 0
                ;;
            *)
                echo "❌ Please enter 'y' for yes or 'n' for no."
                ;;
        esac
    done
    
    # Proceed with actual extension
    if [[ "$extend_file" == "file1" ]]; then
        extend_csv_files "$file1" "$file2" "$target_match_cols" "$source_match_cols" "$extend_file" "$add_cols" "$match_type" "$bidirectional"
    else
        extend_csv_files "$file1" "$file2" "$source_match_cols" "$target_match_cols" "$extend_file" "$add_cols" "$match_type" "$bidirectional"
    fi
    
    echo "🎉 CSV extension completed successfully!"
}

# Run main function
main "$@"