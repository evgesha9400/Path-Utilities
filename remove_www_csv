#!/bin/bash

# CSV Remove www Script
# Removes 'www.' substring from URLs in specified columns in CSV files
# Handles both plain domains (www.example.com) and URLs with protocols (http://www.example.com)

set -e  # Exit on any error

# Function to get CSV header
get_header() {
    head -n 1 "$1"
}

# Function to get column names from CSV
get_columns() {
    python3 -c "
import csv
import sys

with open('$1', 'r', encoding='utf-8') as f:
    reader = csv.reader(f)
    headers = next(reader)
    for i, header in enumerate(headers):
        print(f'{i+1:2d}) {header.strip()}')
"
}

# Function to analyze CSV and count rows with 'www.'
analyze_www_occurrences() {
    local filename="$1"
    local col_idx="$2"
    
    # Run Python script and capture its output
    python3 -c "
import csv
import sys
import re
import json

filename = '$filename'
col_idx = $col_idx - 1  # Convert to 0-based indexing

try:
    with open(filename, 'r', encoding='utf-8') as f:
        reader = csv.reader(f)
        headers = next(reader)
        
        if col_idx >= len(headers):
            print(f'❌ Column index {col_idx + 1} is out of range. File has {len(headers)} columns.')
            sys.exit(1)
        
        total_rows = 0
        matching_rows = 0
        matching_examples = []
        
        for row_num, row in enumerate(reader, 2):  # Start from 2 since we already read header
            total_rows += 1
            
            # Pad row if it has fewer columns than headers
            while len(row) < len(headers):
                row.append('')
            
            if col_idx < len(row):
                cell_value = row[col_idx].strip()
                # Check for www. in a case-insensitive way using regex
                if re.search(r'(https?://)?(www\.)', cell_value, re.IGNORECASE):
                    matching_rows += 1
                    # Store first few examples
                    if len(matching_examples) < 3:
                        matching_examples.append(cell_value)
        
        # Only show examples
        if matching_examples:
            print(f'Examples of URLs with "www.":')
            for example in matching_examples:
                print(f'  - {example}')
        
        # Print hidden marker with values for the script to parse
        print(f'###STATS###:{total_rows}:{matching_rows}:{headers[col_idx].strip()}')
        
except Exception as e:
    print(f'❌ Error analyzing file: {e}')
    sys.exit(1)
"
}

# Function to remove 'www.' from CSV column
remove_www_from_csv() {
    local filename="$1"
    local col_idx="$2"
    
    python3 -c "
import csv
import sys
import os
import re

filename = '$filename'
col_idx = $col_idx - 1  # Convert to 0-based indexing

try:
    # Read the original file
    with open(filename, 'r', encoding='utf-8') as f:
        reader = csv.reader(f)
        headers = next(reader)
        
        if col_idx >= len(headers):
            print(f'❌ Column index {col_idx + 1} is out of range. File has {len(headers)} columns.')
            sys.exit(1)
        
        # Prepare output filename
        base_name = filename.replace('.csv', '')
        output_filename = f'{base_name}_Removed_www.csv'
        
        # Read all rows
        rows = []
        modified_count = 0
        examples = []
        
        for row in reader:
            # Pad row if it has fewer columns than headers
            while len(row) < len(headers):
                row.append('')
            
            # Check if this row has 'www.' in the specified column
            if col_idx < len(row):
                original_value = row[col_idx]
                
                if re.search(r'(https?://)?(www\.)', original_value, re.IGNORECASE):
                    # Store original value for example (up to 3)
                    if len(examples) < 3:
                        examples.append((original_value, None))
                    
                    # Remove 'www.' substring while preserving http:// or https:// if present
                    modified_value = re.sub(r'(https?://)?www\.', r'\1', original_value, flags=re.IGNORECASE)
                    row[col_idx] = modified_value
                    modified_count += 1
                    
                    # Update the example with the modified value
                    if len(examples) > 0 and examples[-1][0] == original_value:
                        examples[-1] = (original_value, modified_value)
            
            rows.append(row)
        
        # Write the modified data to new file
        with open(output_filename, 'w', encoding='utf-8', newline='') as f:
            writer = csv.writer(f)
            writer.writerow(headers)
            writer.writerows(rows)
        
        # Display results
        print(f'✓ Created {output_filename}')
        print(f'✓ Modified {modified_count:,} rows')
        print(f'✓ Original file: {filename}')
        print(f'✓ New file: {output_filename}')
        
        # Display examples if available
        if examples:
            print('Examples of changes:')
            for i, (before, after) in enumerate(examples):
                if before and after:
                    print(f\"Example {i+1}: '{before}' → '{after}'\")
        
except Exception as e:
    print(f'❌ Error processing file: {e}')
    sys.exit(1)
"
}

# Main script
main() {
    echo "🔍 Scanning for CSV files in current directory..."
    
    # Find all CSV files (compatible with zsh)
    csv_files=()
    while IFS= read -r -d '' file; do
        # Remove ./ prefix if present
        file=${file#./}
        csv_files+=("$file")
    done < <(find . -maxdepth 1 -name "*.csv" -type f -print0 | sort -z)
    
    local num_files=${#csv_files[@]}
    
    if [[ $num_files -eq 0 ]]; then
        echo "❌ No CSV files found in current directory."
        exit 1
    elif [[ $num_files -eq 1 ]]; then
        echo "📁 Found 1 CSV file:"
        echo "   ${csv_files[0]}"
        local selected_file="${csv_files[0]}"
    else
        echo "📁 Found $num_files CSV files:"
        for i in "${!csv_files[@]}"; do
            echo "   $((i+1))) ${csv_files[$i]}"
        done
        echo
        
        # Get file selection
        while true; do
            read -p "Select file number (1-$num_files): " -r file_choice
            if [[ "$file_choice" =~ ^[0-9]+$ ]] && [[ "$file_choice" -ge 1 ]] && [[ "$file_choice" -le "$num_files" ]]; then
                selected_file="${csv_files[$((file_choice-1))]}"
                break
            else
                echo "❌ Invalid choice. Please enter a number between 1 and $num_files."
            fi
        done
    fi
    
    echo
    echo "📋 Selected file: $selected_file"
    echo
    
    # Check if file is readable
    if [[ ! -r "$selected_file" ]]; then
        echo "❌ Cannot read $selected_file"
        exit 1
    fi
    
    # Show headers
    echo "📋 File headers:"
    get_columns "$selected_file"
    echo
    
    # Get column selection
    local num_cols=$(python3 -c "
import csv
with open('$selected_file', 'r', encoding='utf-8') as f:
    reader = csv.reader(f)
    headers = next(reader)
    print(len(headers))
")
    
    while true; do
        read -p "Select column number to remove 'www.' from (1-$num_cols): " -r col_choice
        if [[ "$col_choice" =~ ^[0-9]+$ ]] && [[ "$col_choice" -ge 1 ]] && [[ "$col_choice" -le "$num_cols" ]]; then
            break
        else
            echo "❌ Invalid choice. Please enter a number between 1 and $num_cols."
        fi
    done
    
    echo
    
    # Analyze the file and show summary
    echo "🔍 Analyzing file for 'www.' occurrences..."
    echo
    
    # Run analysis and capture output
    local analysis_output=$(analyze_www_occurrences "$selected_file" "$col_choice")
    
    # Extract the stats line from the output
    local stats_line=$(echo "$analysis_output" | grep "###STATS###")
    
    # Parse the stats line to get values
    if [[ -n "$stats_line" ]]; then
        # Remove the marker and split by colon
        stats_line=${stats_line#"###STATS###:"}
        IFS=':' read -r total_rows matching_rows column_name <<< "$stats_line"
    else
        # Default values if stats line not found
        total_rows=0
        matching_rows=0
        column_name="Unknown"
    fi
    
    # Add an empty line for better readability
    echo
    
    # Display summary
    echo "📊 Summary:"
    echo "   File: $selected_file"
    echo "   Column: $column_name"
    echo "   Total rows: $(printf "%'d" $total_rows)"
    echo "   Rows with 'www.': $(printf "%'d" $matching_rows)"
    if [[ $total_rows -gt 0 ]]; then
        percentage=$(echo "scale=1; $matching_rows * 100 / $total_rows" | bc)
        echo "   Percentage: ${percentage}%"
    else
        echo "   Percentage: 0.0%"
    fi
    echo
    
    if [[ -z "$matching_rows" ]] || [[ $matching_rows -eq 0 ]]; then
        echo "ℹ️  No rows found with 'www.' in the selected column."
        echo "   No action needed."
        exit 0
    fi
    
    # Prompt user to proceed
    echo "⚠️  This will create a new file with 'www.' removed from $(printf "%'d" $matching_rows) rows."
    echo "   Example: 'www.example.com' → 'example.com' and 'https://www.example.com' → 'https://example.com'"
    echo "   Original file will remain unchanged."
    echo
    
    while true; do
        read -p "Do you want to proceed? (y/n): " -r proceed_choice
        case $proceed_choice in
            [Yy]*)
                echo
                echo "📝 Processing file..."
                remove_www_from_csv "$selected_file" "$col_choice"
                echo
                echo "🎉 Process completed successfully!"
                break
                ;;
            [Nn]*)
                echo "❌ Operation cancelled."
                exit 0
                ;;
            *)
                echo "❌ Please enter 'y' or 'n'."
                ;;
        esac
    done
}

# Run main function
main "$@"
