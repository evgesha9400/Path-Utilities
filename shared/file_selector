#!/bin/bash

# File Selector Component
# A reusable component for selecting files with dynamic rendering
# Can be used across multiple utilities

# Usage:
# source file_selector
# 
# # Call the function with:
# select_files "Title text" min_files max_files "file_pattern" [directory]
# 
# # Example: Select 2 or more CSV files from current directory
# select_files "CSV File Selection" 2 0 "*.csv"
# 
# # Example: Select exactly 2 text files from /tmp
# select_files "Select Input Files" 2 2 "*.txt" "/tmp"
#
# # After calling, selected files are available in the $selected_files array

# Function to select files with interactive menu
select_files() {
    local title="$1"          # Menu title
    local min_files="$2"      # Minimum number of files required (must be >= 1)
    local max_files="$3"      # Maximum number of files allowed (0 = unlimited)
    local file_pattern="$4"   # File pattern to match (e.g., "*.csv")
    local directory="${5:-.}" # Directory to search (default: current directory)
    
    # Validate parameters
    if [[ -z "$title" || -z "$min_files" || -z "$file_pattern" ]]; then
        echo "Error: Missing required parameters for select_files function" >&2
        echo "Usage: select_files \"Title\" min_files max_files \"file_pattern\" [directory]" >&2
        return 1
    fi
    
    # Ensure min_files is at least 1
    if [[ $min_files -lt 1 ]]; then
        min_files=1
    fi
    
    # Find all matching files
    local all_files=()
    while IFS= read -r -d '' file; do
        all_files+=("$file")
    done < <(find "$directory" -maxdepth 1 -name "$file_pattern" -type f -print0 | sort -z)
    
    # Check if we found any files
    if [[ ${#all_files[@]} -eq 0 ]]; then
        echo "❌ No files matching '$file_pattern' found in $directory."
        return 1
    fi
    
    # Check if we have enough files to meet minimum requirement
    if [[ ${#all_files[@]} -lt $min_files ]]; then
        echo "❌ Found only ${#all_files[@]} files, but $min_files are required."
        return 1
    fi
    
    # Initialize selection status array
    local file_statuses=()
    for i in "${!all_files[@]}"; do
        file_statuses[i]="false"
    done
    
    # Prepare requirement text
    local requirement=""
    if [[ $min_files -eq $max_files && $max_files -ne 0 ]]; then
        requirement="exactly $min_files"
    elif [[ $max_files -eq 0 ]]; then
        requirement="at least $min_files"
    else
        requirement="between $min_files and $max_files"
    fi
    
    # Use a simple ANSI escape sequence to move cursor to beginning of line and clear screen
    local CLEAR_SCREEN=$'\033[H\033[J'
    
    while true; do
        # Clear screen and redraw
        echo -n "$CLEAR_SCREEN"
        
        # Display header
        echo "📁 $title"
        echo "=================================="
        echo "Select $requirement files:"
        echo
        
        # Display files with selection status
        for i in "${!all_files[@]}"; do
            local status="[ ]"
            if [[ "${file_statuses[i]}" == "true" ]]; then
                status="[✓]"
            fi
            printf "%2d) %s %s\n" $((i+1)) "$status" "$(basename "${all_files[i]}")"
        done
        
        # Count selected files
        local selected_count=0
        for status in "${file_statuses[@]}"; do
            if [[ "$status" == "true" ]]; then
                ((selected_count++))
            fi
        done
        
        # Display commands and status
        echo
        echo "Commands:"
        echo "  1-${#all_files[@]}: Toggle file selection"
        echo "  a: Select all files"
        echo "  c: Clear all selections"
        echo "  d: Done (proceed with selected files)"
        echo "  q: Quit"
        echo
        
        echo "Selected files: $selected_count"
        if [[ $min_files -eq $max_files ]]; then
            echo "⚠️  Need exactly $min_files files"
        elif [[ $selected_count -lt $min_files ]]; then
            echo "⚠️  Need at least $min_files files"
        elif [[ $max_files -ne 0 && $selected_count -gt $max_files ]]; then
            echo "⚠️  Maximum $max_files files allowed"
        fi
        echo
        
        read -p "Enter choice: " -r choice
        
        case "$choice" in
            [1-9]|[1-9][0-9]|[1-9][0-9][0-9])
                if [[ $choice -ge 1 && $choice -le ${#all_files[@]} ]]; then
                    local idx=$((choice-1))
                    if [[ "${file_statuses[idx]}" == "true" ]]; then
                        file_statuses[idx]="false"
                    else
                        file_statuses[idx]="true"
                    fi
                else
                    echo "Invalid file number. Press Enter to continue..."
                    read
                fi
                ;;
            a|A)
                for i in "${!file_statuses[@]}"; do
                    file_statuses[i]="true"
                done
                ;;
            c|C)
                for i in "${!file_statuses[@]}"; do
                    file_statuses[i]="false"
                done
                ;;
            d|D)
                # Check if selection meets requirements
                if [[ $selected_count -lt $min_files ]]; then
                    echo "❌ Need at least $min_files files. Press Enter to continue..."
                    read
                    continue
                fi
                
                if [[ $max_files -ne 0 && $selected_count -gt $max_files ]]; then
                    echo "❌ Maximum $max_files files allowed. Press Enter to continue..."
                    read
                    continue
                fi
                
                # Build selected files array
                selected_files=()
                for i in "${!all_files[@]}"; do
                    if [[ "${file_statuses[i]}" == "true" ]]; then
                        selected_files+=("${all_files[i]}")
                    fi
                done
                break
                ;;
            q|Q)
                echo "❌ Operation cancelled."
                return 1
                ;;
            *)
                echo "Invalid choice. Press Enter to continue..."
                read
                ;;
        esac
    done
    
    return 0
}

# If script is run directly (not sourced), show usage
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "This is a library script and should be sourced, not executed directly."
    echo
    echo "Usage:"
    echo "  source $(basename "$0")"
    echo "  select_files \"Title\" min_files max_files \"file_pattern\" [directory]"
    echo
    echo "Example:"
    echo "  select_files \"Select CSV Files\" 2 0 \"*.csv\" ."
    echo
    echo "After calling, selected files are available in the \$selected_files array"
    exit 1
fi